+// keeps at most `keep` checkpoints and checkpoint_bytes_max bytes, dropping the oldest first; one larger than that is
+// not kept, and a truncate of its response is refused
+bool server_realtime_slot::save_checkpoint(int32_t id, int32_t keep) {
+    const auto t0 = std::chrono::steady_clock::now();
+    checkpoint cp;
+    cp.id     = id;
+    cp.n_past = n_past;
+    const size_t size = llama_state_seq_get_size_ext(ctx, seq_id, LLAMA_STATE_SEQ_FLAGS_PARTIAL_ONLY);
+    if (size <= checkpoint_bytes_max) {
+        cp.state.resize(size);
+        if (llama_state_seq_get_data_ext(ctx, cp.state.data(), size, seq_id, LLAMA_STATE_SEQ_FLAGS_PARTIAL_ONLY) != size) {
+            return fail("failed to save the conversation state");
+        }
+        checkpoint_bytes += size;
+        checkpoints.push_back(std::move(cp));
+    }
+    const size_t n_keep = std::min((size_t) std::max(keep, 0), n_checkpoints_max);
+    while (!checkpoints.empty() && (checkpoints.size() > n_keep || checkpoint_bytes > checkpoint_bytes_max)) {
+        checkpoint_bytes -= checkpoints.front().state.size();
+        checkpoints.pop_front();
+    }
+    LOG_INF("realtime: checkpoint %d at n_past = %d, %.3f MiB, %.2f ms, %zu kept (%.3f MiB)\n", id, n_past,
+            size / 1048576.0, std::chrono::duration<double, std::milli>(std::chrono::steady_clock::now() - t0).count(),
+            checkpoints.size(), checkpoint_bytes / 1048576.0);
+    return true;
+}
+
+// the conversation as it was at the checkpoint: its SWA and recurrent state put back, the full-attention cells after it
+// removed, and the checkpoints after it dropped. 1 when done; 0 with `refused` set when the checkpoint is gone, and
+// nothing changed; -1 on a failure that leaves the sequence unknown, which ends the session
+int server_realtime_slot::rewind(int32_t id, std::string & refused) {
+    const auto t0 = std::chrono::steady_clock::now();
+    auto it = std::find_if(checkpoints.begin(), checkpoints.end(), [id](const checkpoint & c) { return c.id == id; });
+    if (it == checkpoints.end()) {
+        refused = "the response's checkpoint was dropped";
+        return 0;
+    }
+    const llama_pos from = n_past;
+    if (std::getenv("LLAMA_RT_REWIND_CUT_ONLY")) {
+        // research only: cut the sequence at the checkpoint with no saved state, as a plain KV rewind would
+        const bool ok = llama_memory_seq_rm(llama_get_memory(ctx), seq_id, it->n_past, -1);
+        LOG_INF("realtime: cut-only rewind from n_past = %d to %d: seq_rm %s\n", from, it->n_past, ok ? "true" : "false");
+        if (!ok) {
+            fail("the sequence cannot be cut at the checkpoint without its saved state");
+            return -1;
+        }
+    } else {
+        if (llama_state_seq_set_data_ext(ctx, it->state.data(), it->state.size(), seq_id, LLAMA_STATE_SEQ_FLAGS_PARTIAL_ONLY) != it->state.size()) {
+            fail("failed to restore the conversation state");
+            return -1;
+        }
+        if (!llama_memory_seq_rm(llama_get_memory(ctx), seq_id, it->n_past, -1)) {
+            fail("failed to remove the conversation after the checkpoint");
+            return -1;
+        }
+    }
+    n_past = it->n_past;
+    for (auto c = it; c != checkpoints.end(); ++c) {
+        checkpoint_bytes -= c->state.size();
+    }
+    checkpoints.erase(it, checkpoints.end());
+    LOG_INF("realtime: rewound checkpoint %d from n_past = %d to %d, %.2f ms\n", id, from, n_past,
+            std::chrono::duration<double, std::milli>(std::chrono::steady_clock::now() - t0).count());
+    return 1;
+}
