+bool server_realtime_slot::save_checkpoint(int32_t id) {
+    const auto t0 = std::chrono::steady_clock::now();
+    checkpoint cp;
+    cp.id     = id;
+    cp.n_past = n_past;
+    const size_t size = llama_state_seq_get_size_ext(ctx, seq_id, LLAMA_STATE_SEQ_FLAGS_PARTIAL_ONLY);
+    cp.state.resize(size);
+    if (llama_state_seq_get_data_ext(ctx, cp.state.data(), size, seq_id, LLAMA_STATE_SEQ_FLAGS_PARTIAL_ONLY) != size) {
+        return fail("failed to save the conversation state");
+    }
+    checkpoints.push_back(std::move(cp));
+    while (checkpoints.size() > n_checkpoints_max) {
+        checkpoints.pop_front();
+    }
+    LOG_INF("realtime: checkpoint %d at n_past = %d, %.3f MiB, %.2f ms\n", id, n_past, size / 1048576.0,
+            std::chrono::duration<double, std::milli>(std::chrono::steady_clock::now() - t0).count());
+    return true;
+}
+
+// the conversation as it was at the checkpoint: its SWA and recurrent state put back, the full-attention cells after it
+// removed, and the checkpoints after it dropped
+bool server_realtime_slot::rewind(int32_t id) {
+    const auto t0 = std::chrono::steady_clock::now();
+    auto it = std::find_if(checkpoints.begin(), checkpoints.end(), [id](const checkpoint & c) { return c.id == id; });
+    if (it == checkpoints.end()) {
+        return fail("no checkpoint for the response", ERROR_TYPE_INVALID_REQUEST);
+    }
+    const llama_pos from = n_past;
+    if (std::getenv("LLAMA_RT_REWIND_CUT_ONLY")) {
+        // research: cut the sequence at the checkpoint with no saved state, as a plain KV rewind would
+        const bool ok = llama_memory_seq_rm(llama_get_memory(ctx), seq_id, it->n_past, -1);
+        LOG_INF("realtime: cut-only rewind from n_past = %d to %d: seq_rm %s\n", from, it->n_past, ok ? "true" : "false");
+        if (!ok) {
+            return fail("the sequence cannot be cut at the checkpoint without its saved state");
+        }
+        n_past = it->n_past;
+        checkpoints.erase(it, checkpoints.end());
+        return true;
+    }
+    if (llama_state_seq_set_data_ext(ctx, it->state.data(), it->state.size(), seq_id, LLAMA_STATE_SEQ_FLAGS_PARTIAL_ONLY) != it->state.size()) {
+        return fail("failed to restore the conversation state");
+    }
+    if (!llama_memory_seq_rm(llama_get_memory(ctx), seq_id, it->n_past, -1)) {
+        return fail("failed to remove the conversation after the checkpoint");
+    }
+    n_past = it->n_past;
+    checkpoints.erase(it, checkpoints.end());
+    LOG_INF("realtime: rewound checkpoint %d from n_past = %d to %d, %.2f ms\n", id, from, n_past,
+            std::chrono::duration<double, std::milli>(std::chrono::steady_clock::now() - t0).count());
+    return true;
+}
